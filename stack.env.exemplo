# PROMeiro — variáveis do stack, em blocos. Copie para o Portainer (Stacks → promeiro → Environment variables,
# ou "Load variables from .env file") e preencha. Vazia = aquela parte fica desligada; o log da partida diz o que falta.
# No Portainer ficam só os segredos (marcados com 🔒, nunca no repositório) e a infraestrutura. Onde as coisas estão
# no Trello e no Teable (listas, campos, opções, tabelas), as praças e os administradores são da tela de Configuração
# do app (menu do perfil), que guarda no próprio PROMeiro (ADR 0007). As opcionais do fim só servem de partida.

# ---- Acesso ----
# Cloudflare Access: domínio da equipe e AUD Tag da aplicação (o servidor confere a assinatura do login)
ACCESS_TEAM_DOMAIN=suaequipe.cloudflareaccess.com
ACCESS_AUD=
# 1 = sem login, cada pessoa se identifica no app (só para demonstração)
PERFIL_LOCAL=0
# aberto: todos veem e editam todos os roteiros · privado: cada um vê os seus e os que recebeu
ACESSO=aberto
# endereço público, para o link do roteiro e o do PDF dele (/api/anexos/…) no registro da produção
PROMEIRO_URL=https://promeiro.exemplo.com
# 🔒 o pôster dos filmes aberto sem login, para o Padeiro (o fluxo filmes-recentes do n8n manda o endereço):
# PROMEIRO_URL/api/publico/poster/<registro do filme>?t=<este token>. Precisa de um Bypass no Access só para o caminho
# /api/publico/poster (veja o README). Vazia: o endereço público fica desligado (404). Gere com: openssl rand -hex 24
POSTER_PUBLICO_TOKEN=

# ---- Servidor ----
PORTA=8080
BACKUPS=14
# rede Docker do Teable (o container entra nela)
REDE_TEABLE=teable-network
# a rede da stack do n8n, onde está o Stirling-PDF
REDE_N8N=n8n-network

# ---- Teable ----
# endereço na rede Docker e um token só, que lê e grava 🔒
TEABLE_URL=http://teable:3000
TEABLE_TOKEN=
# o Postgres do Teable (só leitura): postgres://USUARIO:SENHA@teable-db:5432/BANCO 🔒
TEABLE_PG_URL=

# ---- Administradores ----
# a chave-mestra: quem está aqui é sempre administrador (e-mails separados por vírgula) e só sai por aqui. Os outros
# administradores são postos e tirados na Configuração → Pessoas
CADASTRO_ADMINS=

# ---- Trello ----
# API key (32 caracteres) e token (64 ou mais, começa com ATTA) 🔒
TRELLO_KEY=
TRELLO_TOKEN=
# O aviso do Trello (#87) fica DESLIGADO: por enquanto o PROMeiro só ESCREVE no Trello; o que ele lê (a produção, os
# eventos da Produção, as Pessoas, as Duplicadas) vem do Teable (ADR 0006). Deixe vazio: não precisa do TRELLO_SEGREDO
# nem da exceção no Cloudflare Access. Só com TRELLO_AVISO=1 o PROMeiro registra o webhook do quadro e a rota
# /api/trello/aviso responde; aí, sim, o Secret da mesma API key (TRELLO_SEGREDO 🔒), o PROMEIRO_URL e um Bypass no
# Access só para esse caminho (veja o README)
TRELLO_AVISO=
TRELLO_SEGREDO=

# ---- OneDrive (cópia do arquivo original, por SFTP) ----
SFTP_HOST=
SFTP_USUARIO=
# 🔒
SFTP_SENHA=

# ---- PDF do card: conversão fiel do original (opcional) ----
# O PDF anexado ao card é sempre o roteiro como chegou. PDF vai como veio; Word e RTF são convertidos pelo
# Stirling-PDF (LibreOffice), idênticos ao original. Sem ele, o PDF sai do texto do original, com o mesmo sublinhado.
# Endereço do Stirling na rede do n8n (REDE_N8N): o nome do container dele e a porta, ex.: http://stirling-pdf:8080
STIRLING_URL=
# 🔒 a chave de API do Stirling (vai no cabeçalho X-API-KEY)
STIRLING_CHAVE=

# ---- n8n: a aba Filmes (a prévia de filmes) ----
# A leitura de cada página da prévia por IA, no n8n (o mesmo webhook do FilmeBOT), chamada pela rede do n8n
# (REDE_N8N), ex.: http://n8n:5678/webhook/... Vazia: a aba Filmes fica desligada.
N8N_FILMES_LER=
# Onde ficam as imagens das prévias (padrão: a pasta previas dentro dos dados)
FILMES_PASTA=

# ---- GitHub: o Andamento do projeto (opcional; só administradores, no menu do perfil) ----
# O PROMeiro lê as issues e os commits do repositório pela API do GitHub, só leitura. Vazias: a página Andamento diz o
# que falta e mostra a última leitura guardada.
# 🔒 token de acesso pessoal fine-grained, só leitura de Issues e Contents deste repositório
GITHUB_TOKEN=
# o repositório, dono/nome (o deste projeto)
GITHUB_REPO=
# a branch de desenvolvimento cujos commits dizem o que está pronto no código, "(#N)" no título (vazia: a padrão)
GITHUB_BRANCH=

# ---- Túnel do Cloudflare (opcional; só se for subir o cloudflared junto) ----
# COMPOSE_PROFILES=tunel
# TUNNEL_TOKEN=   (🔒)

# ---- Opcionais: pode ficar vazia: a Configuração do app guarda ----
# Cada uma vale só enquanto a tela não tiver um valor salvo para ela; na primeira vez, a tela começa com estas. A
# página "Pode apagar do Portainer" (no rodapé da Configuração) diz quais já podem sair do stack.
# A base do Teable (o ID bse…, que é também o esquema do Postgres): a de partida, até a Configuração → Conexões trocar
# (sem ela e sem a base salva na tela, o Teable fica desligado). As tabelas são achadas pelo nome nela, e o nome
# delas no Postgres vem do próprio Teable
TEABLE_PG_ESQUEMA=
# os IDs das tabelas (tbl…), só se a tabela tiver outro nome na base: atracoes, KEY_atracoes, redatores,
# KEY_redatores, editores, KEY_editores, EDICAO_producao, ARTE_producao, ARTES_acervo, filmes, exibicoes
TEABLE_CADASTRO=
TEABLE_ATRACOES=
TEABLE_REDATORES=
TEABLE_KEY_REDATORES=
TEABLE_EDITORES=
TEABLE_KEY_EDITORES=
TEABLE_PAUTA=
TEABLE_ARTE_PRODUCAO=
TEABLE_ACERVO=
TEABLE_FILMES=
TEABLE_EXIBICOES=
# o campo do pôster na tabela filmes (fld…), só se não se chamar "poster"
TEABLE_FILMES_POSTER=
# o quadro do Trello (o "idBoard" do .json de um card); sem ele, o quadro sai da lista de uma praça
TRELLO_QUADRO=
# as listas e os campos do quadro, pelo ID (Praças, Card e Filmes ligam pelo nome e guardam o ID)
TRELLO_LISTA=
TRELLO_LISTA_SP=
TRELLO_LISTA_RJ=
TRELLO_LISTA_G5=
TRELLO_LISTA_INTER=
TRELLO_SAIDA_SP=
TRELLO_SAIDA_RJ=
TRELLO_SAIDA_G5=
TRELLO_SAIDA_INTER=
TRELLO_LISTA_VT=
TRELLO_LISTA_ENTREGUES=
TRELLO_CAMPO_PRACA=
TRELLO_PRACAS=
TRELLO_CAMPO_REDATOR=
TRELLO_CAMPO_EDITOR=
TRELLO_CAMPO_PRIORIDADE=
TRELLO_PRIORIDADE_ALTA=
TRELLO_PRIORIDADE_MEDIA=
TRELLO_CAMPO_COMPLEXIDADE=
TRELLO_COMPLEXIDADE_OPCOES=
TRELLO_CAMPO_PROJETO=
TRELLO_CAMPO_OUTPUT=
TRELLO_CAMPO_BOT=
TRELLO_CAMPO_ENTRADA=
TRELLO_CAMPOS_FILME=
TRELLO_LISTA_FILMES=
TRELLO_FILMES_ETIQUETAS=
TRELLO_FILMES_ETIQUETAS_SESSAO=
TRELLO_FILMES_PRACA=
# a leitura da prévia de filmes, em milissegundos: a pausa entre as páginas (padrão 2500) e a espera de uma (240000)
FILMES_INTERVALO_MS=
FILMES_TEMPO_MS=
