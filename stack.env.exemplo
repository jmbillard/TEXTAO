# PROMeiro — variáveis do stack, em blocos. Copie para o Portainer (Stacks → promeiro → Environment variables,
# ou "Load variables from .env file") e preencha. Vazia = aquela parte fica desligada; o log da partida diz o que falta.
# Segredos (marcados com 🔒) ficam só no Portainer: nunca no repositório.

# ---- Acesso ----
# Cloudflare Access: domínio da equipe e AUD Tag da aplicação (o servidor confere a assinatura do login)
ACCESS_TEAM_DOMAIN=suaequipe.cloudflareaccess.com
ACCESS_AUD=
# 1 = sem login, cada pessoa se identifica no app (só para demonstração)
PERFIL_LOCAL=0
# aberto: todos veem e editam todos os roteiros · privado: cada um vê os seus e os que recebeu
ACESSO=aberto
# endereço público, para o link do roteiro no registro da produção
PROMEIRO_URL=https://promeiro.exemplo.com

# ---- Servidor ----
PORTA=8080
BACKUPS=14
# rede Docker do Teable (o container entra nela)
REDE_TEABLE=teable-network
# a rede da stack do n8n, onde está o Stirling-PDF
REDE_N8N=n8n-network

# ---- Teable: API ----
# endereço na rede Docker e um token só, que lê e grava 🔒
TEABLE_URL=http://teable:3000
TEABLE_TOKEN=
# IDs das tabelas (tbl…)
# KEY_atracoes (key → atração)
TEABLE_ATRACOES=
# atracoes (nome, categoria, caminhos)
TEABLE_CADASTRO=
# redatores
TEABLE_REDATORES=
# editores
TEABLE_EDITORES=
# KEY_editores (key → editor)
TEABLE_KEY_EDITORES=
# KEY_redatores (key → redator: o autor do Word, o login)
TEABLE_KEY_REDATORES=
# EDICAO_producao (pauta da edição)
TEABLE_PAUTA=
# ARTE_producao (registro de cada envio)
TEABLE_ARTE_PRODUCAO=
# ARTES_acervo (as artes que cada atração já tem prontas; opcional)
TEABLE_ACERVO=
# filmes (o cadastro: o pôster aparece no card da fila; o envio da aba Filmes cadastra o filme novo e completa o ano)
TEABLE_FILMES=
# o campo do pôster na tabela de filmes (fld…): o envio da aba Filmes sobe o pôster recortado da prévia para ele
TEABLE_FILMES_POSTER=
# exibicoes (filme + sessão + dia + card): o envio da aba Filmes grava a exibição de cada card de filme
TEABLE_EXIBICOES=

# ---- Teable: Postgres (só leitura) ----
# postgres://USUARIO:SENHA@teable-db:5432/BANCO 🔒
TEABLE_PG_URL=
# esquema = ID da base (bse…); tabelas = nome interno (sem o "bse….")
TEABLE_PG_ESQUEMA=
TEABLE_PG_PAUTA=
TEABLE_PG_ARTE=
# só se o n8n gravar a produção em outra base (esquema.tabela). Com os fluxos já na base do PROMeiro, deixe vazia
TEABLE_PG_ARTE_LEITURA=
TEABLE_PG_ACERVO=
TEABLE_PG_REDATORES=
TEABLE_PG_EDITORES=
TEABLE_PG_ATRACOES=
TEABLE_PG_PRIORIDADE=
# exibições de filme (filme + sessão + dia + card da prévia, com as artes): liga o card ao filme e dá o acervo das
# sessões. Os cards de filme não entram na ARTE_producao: o andamento deles a fila lê do próprio card no Trello
TEABLE_PG_EXIBICOES=
# a tabela de filmes (titulo, ano_de_producao, poster): liga a conferência da aba Filmes com o banco
# (o mesmo filme pelo título sem artigos e o ano, o card que já existe, as artes que ele já tem no acervo)
TEABLE_PG_FILMES=

# ---- Cadastros ----
# quem pode remover atrações, redatores e editores (e-mails separados por vírgula); cadastrar, todos podem
CADASTRO_ADMINS=

# ---- Trello ----
# API key (32 caracteres) e token (64 ou mais, começa com ATTA) 🔒
TRELLO_KEY=
TRELLO_TOKEN=
# listas do quadro da promo, pelo ID (abra um card da lista, acrescente .json ao endereço e copie o "idList")
# a reserva: praça sem a sua entrada vai para cá
TRELLO_LISTA=
# a entrada de cada praça (pela praça da claquete); RJ e G5 podem repetir o mesmo ID.
# Praça sem a sua lista cai na TRELLO_LISTA (com aviso). Ao menos uma entrada é preciso para enviar.
TRELLO_LISTA_SP=
TRELLO_LISTA_RJ=
TRELLO_LISTA_G5=
TRELLO_LISTA_INTER=
# as saídas de cada praça (para onde vão os cards prontos); por enquanto só ficam guardadas
TRELLO_SAIDA_SP=
TRELLO_SAIDA_RJ=
TRELLO_SAIDA_G5=
TRELLO_SAIDA_INTER=
# o quadro da promo, pelo ID (o "idBoard" do .json de um card): a aba Duplicadas dos Cadastros lê os cards dele.
# Vazio = a aba mostra "não configurado"
TRELLO_QUADRO=
# a lista dos projetos entregues, pelo ID: na aba Duplicadas conta como saída (o card dela é o que fica). Opcional
TRELLO_LISTA_ENTREGUES=
# a lista de VT (claquete ou arquivo com "Vt"); vazia = segue a praça
TRELLO_LISTA_VT=
# campos personalizados do quadro (IDs)
TRELLO_CAMPO_PRACA=
TRELLO_PRACAS=G5=,SP=,RJ=,INTER=
TRELLO_CAMPO_REDATOR=
TRELLO_CAMPO_EDITOR=
TRELLO_CAMPO_PRIORIDADE=
TRELLO_PRIORIDADE_ALTA=
TRELLO_CAMPO_PROJETO=
TRELLO_CAMPO_OUTPUT=
TRELLO_CAMPO_BOT=
TRELLO_CAMPO_ENTRADA=
# o campo Complexidade e as suas três opções (IDs, separados por vírgula, na ordem BAIXA,MÉDIA,ALTA): o card leva a
# maior das artes a produzir. Sem eles, o campo não é preenchido (a produção da arte grava o número do mesmo jeito)
TRELLO_CAMPO_COMPLEXIDADE=
TRELLO_COMPLEXIDADE_OPCOES=
# campos copiados do card do filme nas sessões (complexidade, uso de IA), separados por vírgula
TRELLO_CAMPOS_FILME=
# os cards de filme da aba Filmes (como o fluxo CARDS do n8n). Sem a lista, o Enviar da aba fica desligado
TRELLO_LISTA_FILMES=
# as etiquetas de todo card de filme (IDs, separados por vírgula) e, se houver, a de cada sessão (SUPERCINE=id,TELA QUENTE=id)
TRELLO_FILMES_ETIQUETAS=
TRELLO_FILMES_ETIQUETAS_SESSAO=
# a opção do campo da praça (TRELLO_CAMPO_PRACA) que vai nos cards de filme
TRELLO_FILMES_PRACA=
# a opção MÉDIA do campo de prioridade: vai no card do filme inédito
TRELLO_PRIORIDADE_MEDIA=

# ---- OneDrive (cópia do arquivo original, por SFTP) ----
SFTP_HOST=
SFTP_USUARIO=
# 🔒
SFTP_SENHA=

# ---- PDF do card: conversão fiel do original (opcional) ----
# O PDF anexado ao card é sempre o roteiro como chegou. PDF vai como veio; Word e RTF são convertidos pelo
# Stirling-PDF (LibreOffice), idênticos ao original. Sem ele, o PDF sai do texto do original, com o mesmo sublinhado.
# Endereço do Stirling na rede do n8n (REDE_N8N): o nome do container dele e a porta, ex.: http://stirling-pdf:8080
STIRLING_URL=
# 🔒 a chave de API do Stirling (vai no cabeçalho X-API-KEY)
STIRLING_CHAVE=

# ---- n8n: a aba Filmes (a prévia de filmes) ----
# A leitura de cada página da prévia por IA, no n8n (o mesmo webhook do FilmeBOT), chamada pela rede do n8n
# (REDE_N8N), ex.: http://n8n:5678/webhook/... Vazia: a aba Filmes fica desligada.
N8N_FILMES_LER=
# Pausa entre uma página e outra na fila de leitura, em milissegundos (padrão 2500)
FILMES_INTERVALO_MS=
# Quanto esperar a leitura de uma página, em milissegundos (padrão 240000)
FILMES_TEMPO_MS=
# Onde ficam as imagens das prévias (padrão: a pasta previas dentro dos dados)
FILMES_PASTA=

# ---- Túnel do Cloudflare (opcional; só se for subir o cloudflared junto) ----
# COMPOSE_PROFILES=tunel
# TUNNEL_TOKEN=   (🔒)

# Não são mais usadas (pode apagar do stack): TEABLE_TOKEN_ESCRITA, TEABLE_PAUTA_VISAO
